{
  "manifest_version": 3,
  "name": "ReadyMe",
  "version": "1.0",

  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sizeChartExtractor.js", "content.js"]
    }
  ]
}

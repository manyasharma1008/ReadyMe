{
  "manifest_version": 3,
  "name": "ReadyMe",
  "version": "1.0",

  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}